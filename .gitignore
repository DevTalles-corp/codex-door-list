# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/tests/e2e/fixtures/event-covers/
/specs/006-imagenes-en-eventos/screenshots/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build
/dist

# misc
.DS_Store
*.log
*.tmp
*.swp
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep credentials local; version only the safe template.
.env*
!.env.example

# Local tool modules
.modules

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
